  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "88f2972d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "OpenCV image shape: (512, 512)\n",
      "OpenCV array data type: uint8\n",
      "OpenCV image array:\n",
      "[[200 200 200 ... 189 190 190]\n",
      " [200 199 199 ... 190 190 190]\n",
      " [199 199 199 ... 190 190 190]\n",
      " ...\n",
      " [ 25  25  27 ... 139 122 147]\n",
      " [ 25  25  26 ... 158 141 168]\n",
      " [ 25  25  27 ... 151 152 149]]\n"
     ]
    }
   ],
   "source": [
    "# The image loaded with OpenCV is already a NumPy array.\n",
    "print('OpenCV image shape:', img.shape)\n",
    "print('OpenCV array data type:', img.dtype)\n",
    "print('OpenCV image array:')\n",
    "print(img)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "ffaa4797",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PIL image array shape: (256, 256)\n",
      "PIL image array data type: uint8\n",
      "PIL image array:\n",
      "[[199 199 200 ... 190 190 190]\n",
      " [199 199 200 ... 190 190 190]\n",
      " [200 200 199 ... 191 191 191]\n",
      " ...\n",
      " [ 25  25  24 ... 136 143 118]\n",
      " [ 26  25  26 ... 147 154 144]\n",
      " [ 25  25  25 ... 146 146 151]]\n"
     ]
    }
   ],
   "source": [
    "# Convert the PIL Image object to a NumPy array.\n",
    "img_array = np.array(img2)\n",
    "\n",
    "print('PIL image array shape:', img_array.shape)\n",
    "print('PIL image array data type:', img_array.dtype)\n",
    "print('PIL image array:')\n",
    "print(img_array)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e9205ba3",
   "metadata": {},
   "source": [
    "## Assessment: NumPy operations on the image array"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "6f29e920",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Minimum intensity: 0\n",
      "Maximum intensity: 255\n",
      "Mean intensity: 129.06893920898438\n",
      "Standard deviation: 73.04908779785245\n"
     ]
    }
   ],
   "source": [
    "print('Minimum intensity:', np.min(img_array))\n",
    "print('Maximum intensity:', np.max(img_array))\n",
    "print('Mean intensity:', np.mean(img_array))\n",
    "print('Standard deviation:', np.std(img_array))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "f4c2f42e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x400 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Example array operations: negative, brighter image, crop, and horizontal flip.\n",
    "negative_img = 255 - img_array\n",
    "brighter_img = np.clip(img_array.astype(np.int16) + 50, 0, 255).astype(np.uint8)\n",
    "cropped_img = img_array[50:200, 50:200]\n",
    "flipped_img = np.fliplr(img_array)\n",
    "\n",
    "fig, axes = plt.subplots(1, 4, figsize=(16, 4))\n",
    "images = [negative_img, brighter_img, cropped_img, flipped_img]\n",
    "titles = ['Negative', 'Brighter (+50)', 'Cropped', 'Horizontal Flip']\n",
    "\n",
    "for ax, output_image, title in zip(axes, images, titles):\n",
    "    ax.imshow(output_image, cmap='gray', vmin=0, vmax=255)\n",
    "    ax.set_title(title)\n",
    "    ax.axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a307f600",
   "metadata": {},
   "source": [
    "## Conclusion\n",
    "In this lab, images were loaded, displayed, and saved using OpenCV and PIL. The images were represented as NumPy arrays, and several operations were applied to their pixel intensity values."
   ]
  }
