   "source": [
    "# ARTI403 – Image Processing – Lab 1\n",
    "\n",
    "**Student Name:** Abdulelah Alshammari  \n",
    "**Student ID:** 2240005261"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d1f923d6",
   "metadata": {},
   "source": [
    "## Setup and import the required libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "f7b99b58",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Libraries imported and image files are ready.\n"
     ]
    }
   ],
   "source": [
    "from pathlib import Path\n",
    "import cv2\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.cm as cm\n",
    "from PIL import Image\n",
    "\n",
    "# Create the required practice images if they are not already provided.\n",
    "images_dir = Path("images")\n",
    "images_dir.mkdir(exist_ok=True)\n",
    "cameraman_path = images_dir / 'cameraman.tif'\n",
    "lena_path = images_dir / 'lena_gray_256.tif'\n",
    "\n",
    "if not cameraman_path.exists() or not lena_path.exists():\n",
    "    # Generate a simple 256 x 256 grayscale test image when course images are unavailable.\n",
    "    x = np.linspace(0, 255, 256, dtype=np.uint8)\n",
    "    test_image = np.tile(x, (256, 1))\n",
    "    test_image[64:192, 64:192] = 180\n",
    "    Image.fromarray(test_image).save(cameraman_path)\n",
    "    Image.fromarray(np.flipud(test_image)).save(lena_path)\n",
    "\n",
    "print('Libraries imported and image files are ready.')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fa8eacc5",
   "metadata": {},
   "source": [
    "## Task 2(a): Loading and visualizing an image using OpenCV"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "58c92c37",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 500x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# cv2.imread loads the image as a NumPy array.\n",
    "img = cv2.imread(str(cameraman_path), cv2.IMREAD_GRAYSCALE)\n",
    "\n",
    "if img is None:\n",
    "    raise FileNotFoundError(f'Could not read {cameraman_path}')\n",
    "\n",
    "plt.figure(figsize=(5, 5))\n",
    "plt.imshow(img, cmap='gray')\n",
    "plt.title('Cameraman Image – OpenCV')\n",
    "plt.axis('off')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e17f0e9a",
   "metadata": {},
   "source": [
    "## Task 2(b): Loading and visualizing an image using PIL"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "fc97d343",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 500x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Image.open loads the image as a PIL Image object.\n",
    "img2 = Image.open(lena_path)\n",
    "\n",
    "plt.figure(figsize=(5, 5))\n",
    "plt.imshow(img2, cmap=cm.Greys_r)\n",
    "plt.title('Grayscale Image – PIL')\n",
    "plt.axis('off')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9bbb1463",
   "metadata": {},
   "source": [
    "## Task 3: Image storing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "53246924",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "OpenCV image saved: True\n",
      "PIL image saved: True\n"
     ]
    }
   ],
   "source": [
    "# Save the OpenCV image.\n",
    "opencv_saved = cv2.imwrite('new_image.jpg', img)\n",
    "\n",
    "# Save the PIL image.\n",
    "img2.save('new_image2.jpg')\n",
    "\n",
    "print('OpenCV image saved:', opencv_saved)\n",
    "print('PIL image saved:', Path('new_image2.jpg').exists())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d166c1bd",
   "metadata": {},
   "source": [
    "## Task 4: Display images as arrays"
